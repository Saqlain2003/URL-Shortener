{
  "name": "Fewer URL Shortener",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "forwardPorts": [5173, 5000, 27017, 6379],
  "portsAttributes": {
    "5173": {
      "label": "Frontend",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5000": {
      "label": "Backend API",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mongodb.mongodb-vscode"
      ]
    }
  }
}